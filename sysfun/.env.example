# ==========================================
# CONFIGURACIÓN DEL SISTEMA (PLANTILLA)
# ==========================================
# Copia este archivo a .env y completa con tus datos reales.
# NUNCA subas el archivo .env a GitHub.

# Base de Datos
DB_HOST=localhost
DB_NAME=servicios_funebres
DB_USER=root
DB_PASS=tu_contraseña_segura_aqui

# Entorno de la Aplicación
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tudominio.com

# Seguridad y Cookies
SECRET_KEY=cambia_esto_por_una_clave_aleatoria_muy_larga_y_segura
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Strict
COOKIE_LIFETIME=86400

# Archivos
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx